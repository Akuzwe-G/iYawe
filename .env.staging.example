# Template only. Enter actual values in Laravel Cloud environment settings.
# Never use the local/production database, bucket, APP_KEY or customer data.
APP_NAME=iYawe
APP_ENV=staging
APP_DEBUG=false
APP_URL=
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DB_CONNECTION=mysql
# Attach a dedicated MySQL database; use its injected DB_* values.
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=iyawe_staging_session
SESSION_DOMAIN=null
CACHE_STORE=database
CACHE_PREFIX=iyawe_staging_cache
QUEUE_CONNECTION=sync
# Alternatively database, with a Laravel Cloud worker attached.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=iYawe
FILESYSTEM_DISK=s3
IYAWE_DOCUMENTS_DISK=s3
# Attach a PRIVATE staging object-storage bucket as disk s3.
# Use the Cloud-injected credentials; AWS_URL must be unset for private documents.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Framework handles Cloud proxies automatically. Only set for a reviewed custom proxy.
IYAWE_TRUSTED_PROXIES=
# Bootstrap once using environment secrets, then remove credentials after seeding.
IYAWE_SYSTEM_ADMIN_NAME="iYawe Staging Administrator"
IYAWE_SYSTEM_ADMIN_EMAIL=
IYAWE_SYSTEM_ADMIN_PASSWORD=
